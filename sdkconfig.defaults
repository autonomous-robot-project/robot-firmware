CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Log console on the native USB (GPIO 19/20); the link uses UART1 on the GPIO (ADR 043)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# micro-ROS over XRCE-DDS with the custom UART transport of the link component
CONFIG_MICRO_ROS_ESP_XRCE_DDS_MIDDLEWARE=y
CONFIG_MICRO_ROS_ESP_UART_TRANSPORT=y

# 1 ms tick: the link waits for commands with timeouts shorter than the 10 ms of the default tick,
# which would round them to zero and spin the task. The control period T_C stays 10 ms.
CONFIG_FREERTOS_HZ=1000

# LEDC duty updates run in the control task, whose code V-09 asks to be in IRAM
CONFIG_LEDC_CTRL_FUNC_IN_IRAM=y
