{
    "configurations": [
        {
            "name": "ESP32-S3 firmware",
            "compileCommands": [
                "${workspaceFolder}/build/compile_commands.json"
            ],
            "compilerPath": "${env:HOME}/.espressif/tools/xtensa-esp-elf/esp-13.2.0_20250707/xtensa-esp-elf/bin/xtensa-esp32s3-elf-g++",
            "cStandard": "gnu17",
            "cppStandard": "gnu++23",
            "includePath": [
                "${workspaceFolder}/components/**",
                "${workspaceFolder}/managed_components/**",
                "${workspaceFolder}/build/config",
                "${env:HOME}/esp/esp-idf/components/**"
            ]
        }
    ],
    "version": 4
}
